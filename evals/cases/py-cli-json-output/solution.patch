+
+
+def render_json(summary: Summary) -> str:
+    """The summary as one JSON document; amounts are numbers rounded to cents."""
+    return json.dumps({
+        "categories": [
+            {"category": c.category, "count": c.count, "total": float(c.total)}
+            for c in summary.categories
+        ],
+        "count": summary.count,
+        "total": float(summary.total),
+    }, indent=2, ensure_ascii=False) + "\n"
