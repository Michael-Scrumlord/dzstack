+def spread_fixed(amount: int, nets: list[int]) -> list[int]:
+    """Split a fixed discount over the lines in proportion to what each line has left (ADR-0006 leaves the split open).
+
+    The shares add up to exactly min(amount, sum(nets)), and no share is more than its line's net. Leftover
+    cents go to the lines with the largest fractional share, the earlier line first on a tie.
+    """
+    total = sum(nets)
+    take = min(amount, total)
+    if take == 0:
+        return [0] * len(nets)
+    shares = [take * net // total for net in nets]
+    by_remainder = sorted(range(len(nets)), key=lambda i: (-(take * nets[i] % total), i))
+    for i in by_remainder[: take - sum(shares)]:
+        shares[i] += 1
+    return shares
+
+
 def compute(invoice: Invoice) -> ComputedInvoice:
+    amounts = [round_cents(line.quantity * line.unit_price_cents) for line in invoice.lines]
+    nets = list(amounts)
+    applied = []
+    for discount in invoice.discounts:
+        if discount.kind == "percent":
+            cuts = [round_cents(Decimal(net) * discount.percent / 100) for net in nets]
+        else:
+            cuts = spread_fixed(discount.amount_cents, nets)
+        nets = [net - cut for net, cut in zip(nets, cuts)]
+        applied.append(sum(cuts))
     lines = []
-    for line in invoice.lines:
-        amount = round_cents(line.quantity * line.unit_price_cents)
-        tax = tax_cents(amount, line.tax_code, invoice.customer.country)
-        lines.append(ComputedLine(line, amount, tax))
-    subtotal = sum(line.amount_cents for line in lines)
+    for line, amount, net in zip(invoice.lines, amounts, nets):
+        tax = tax_cents(net, line.tax_code, invoice.customer.country)
+        lines.append(ComputedLine(line, amount, amount - net, net, tax))
+    subtotal = sum(amounts)
+    discount_total = sum(applied)
     tax = sum(line.tax_cents for line in lines)
-    return ComputedInvoice(invoice, tuple(lines), subtotal, tax, subtotal + tax)
+    return ComputedInvoice(
