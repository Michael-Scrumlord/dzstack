diff --git a/tests/test_discounts.py b/tests/test_discounts.py
new file mode 100644
index 0000000..85ed3df
--- /dev/null
+++ b/tests/test_discounts.py
@@ -0,0 +1,126 @@
+import csv
+import io
+
+import pytest
+
+from billing import api
+from billing.errors import DocumentError
+from billing.export import export_csv
+from billing.store import Store
+
+
+def one_line(cents=10000, tax_code="standard", **extra):
+    return {"customer": {"name": "Acme GmbH", "country": "DE"}, "issued": "2026-03-02", **extra,
+            "lines": [{"sku": "X", "quantity": "1", "unit_price_cents": cents, "tax_code": tax_code}]}
+
+
+def test_percent_discount_comes_off_before_tax():
+    out = api.compute(one_line(discounts=[{"label": "Loyalty", "kind": "percent", "percent": "10"}]))
+    assert (out["subtotal_cents"], out["discount_cents"], out["tax_cents"], out["total_cents"]) == (10000, 1000, 1710, 10710)
+    assert out["lines"][0]["net_cents"] == 9000 and out["discounts"][0]["applied_cents"] == 1000
+
+
+def test_discounts_stack_in_the_listed_order():
+    two_percents = api.compute(one_line(discounts=[
+        {"label": "A", "kind": "percent", "percent": "10"}, {"label": "B", "kind": "percent", "percent": "10"}]))
+    assert two_percents["discount_cents"] == 1900
+    fixed_first = api.compute(one_line(discounts=[
+        {"label": "A", "kind": "fixed", "amount_cents": 1000}, {"label": "B", "kind": "percent", "percent": "10"}]))
+    assert fixed_first["discount_cents"] == 1900
+    percent_first = api.compute(one_line(discounts=[
+        {"label": "B", "kind": "percent", "percent": "10"}, {"label": "A", "kind": "fixed", "amount_cents": 1000}]))
+    assert percent_first["discount_cents"] == 2000
+
+
+def test_percent_discounts_are_rounded_per_line_half_up():
+    doc = one_line(1030, "exempt", discounts=[{"label": "D", "kind": "percent", "percent": "15"}])
+    doc["lines"].append(dict(doc["lines"][0]))
+    out = api.compute(doc)
+    assert [line["discount_cents"] for line in out["lines"]] == [155, 155]  # 154.5 each; not 309 for the pair
+    assert out["discount_cents"] == 310
+
+
+def test_a_discount_never_takes_more_than_is_left():
+    out = api.compute(one_line(500, "exempt", discounts=[{"label": "Big", "kind": "fixed", "amount_cents": 800}]))
+    assert (out["discounts"][0]["applied_cents"], out["total_cents"]) == (500, 0)
+    out = api.compute(one_line(6000, discounts=[
+        {"label": "A", "kind": "percent", "percent": "60"}, {"label": "B", "kind": "fixed", "amount_cents": 5000}]))
+    assert (out["discount_cents"], out["tax_cents"], out["total_cents"]) == (6000, 0, 0)
+    out = api.compute(one_line(discounts=[{"label": "Free", "kind": "percent", "percent": "100"}]))
+    assert out["total_cents"] == 0
+
+
+def test_a_fixed_discount_takes_exactly_its_amount_across_lines():
+    doc = one_line(3333, "exempt", discounts=[{"label": "Credit", "kind": "fixed", "amount_cents": 1000}])
+    doc["lines"] += [dict(doc["lines"][0]), dict(doc["lines"][0], unit_price_cents=3334)]
+    out = api.compute(doc)
+    assert out["discount_cents"] == 1000 and out["total_cents"] == 9000
+    assert sum(line["discount_cents"] for line in out["lines"]) == 1000
+    assert all(0 <= line["discount_cents"] <= line["amount_cents"] for line in out["lines"])
+
+
+def test_the_computed_form_always_has_the_discount_fields():
+    out = api.compute(one_line())
+    assert out["discounts"] == [] and out["discount_cents"] == 0
+    assert out["lines"][0]["discount_cents"] == 0 and out["lines"][0]["net_cents"] == out["lines"][0]["amount_cents"]
+
+
+@pytest.mark.parametrize("entry", [
+    {"label": "x", "kind": "percent", "percent": "0"}, {"label": "x", "kind": "percent", "percent": "100.5"},
+    {"label": "x", "kind": "percent", "percent": 10}, {"label": "x", "kind": "percent"},
+    {"label": "x", "kind": "percent", "percent": "10", "amount_cents": 5},
+    {"label": "x", "kind": "fixed", "amount_cents": 0}, {"label": "x", "kind": "fixed", "amount_cents": 12.5},
+    {"label": "x", "kind": "fixed", "amount_cents": True}, {"label": "x", "kind": "fixed", "percent": "5"},
+    {"label": "", "kind": "fixed", "amount_cents": 5}, {"kind": "fixed", "amount_cents": 5},
+    {"label": "x", "kind": "bogus"}, {"label": "x", "kind": "fixed", "amount_cents": 5, "extra": 1}, "10%",
+])
+def test_invalid_discounts(entry):
+    with pytest.raises(DocumentError):
+        api.compute(one_line(discounts=[entry]))
+
+
+def test_at_most_five_discounts_and_it_must_be_a_list():
+    five = [{"label": str(i), "kind": "percent", "percent": "1"} for i in range(5)]
+    api.compute(one_line(discounts=five))
+    with pytest.raises(DocumentError, match="at most 5"):
+        api.compute(one_line(discounts=five + five[:1]))
+    with pytest.raises(DocumentError, match="must be a list"):
+        api.compute(one_line(discounts={"label": "x"}))
+
+
+def test_the_discount_is_its_own_row_in_both_renderings():
+    doc = one_line(discounts=[{"label": "Loyalty <10%>", "kind": "percent", "percent": "10"}])
+    lines = api.render(doc).splitlines()
+    rows = [line.split()[0] for line in lines if line.startswith(" " * 36)]
+    assert rows == ["Subtotal", "Discount", "Tax", "TOTAL"]
+    assert any(line.startswith(" " * 36 + "Discount (Loyalty <10%>)") and line.endswith("-$10.00") for line in lines)
+    html = api.render(doc, "html")
+    assert '<tr class="discount"><th colspan="4">Discount (Loyalty &lt;10%&gt;)</th><td class="num">-$10.00</td></tr>' in html
+    assert html.index('class="subtotal"') < html.index('class="discount"') < html.index('class="tax"')
+
+
+def test_export_keeps_its_columns_and_subtotal_plus_tax_is_total(tmp_path):
+    store = Store(tmp_path)
+    store.issue(one_line())
+    store.issue(one_line(discounts=[{"label": "Loyalty", "kind": "percent", "percent": "10"}]))
+    out = list(csv.DictReader(io.StringIO(export_csv(store.all()))))
+    assert list(out[0]) == ["number", "issued", "customer", "currency", "subtotal", "tax", "total"]
+    assert (out[0]["subtotal"], out[0]["tax"], out[0]["total"]) == ("100.00", "19.00", "119.00")
+    assert (out[1]["subtotal"], out[1]["tax"], out[1]["total"]) == ("90.00", "17.10", "107.10")
+
+
+def test_invoices_stored_before_discounts_still_print_and_export(tmp_path):
+    store = Store(tmp_path)
+    number = store.issue(one_line())
+    path = tmp_path / "invoices" / f"{number}.json"
+    import json
+
+    old = json.loads(path.read_text())
+    for key in ("discounts", "discount_cents"):
+        del old[key]
+    for line in old["lines"]:
+        del line["discount_cents"], line["net_cents"]
+    path.write_text(json.dumps(old))
+    assert "TOTAL" in store.show(number) and "Discount" not in store.show(number)
+    assert "<tr class=\"total\">" in store.show(number, "html")
+    assert "2026-0001,2026-03-02,Acme GmbH,USD,100.00,19.00,119.00" in export_csv(store.all())
