new file mode 100644
index 0000000..75392ea
--- /dev/null
+++ b/staffdir/migrations/0007_split_user_names.py
@@ -0,0 +1,52 @@
+"""Split users.full_name into given_name and family_name (the expand step: full_name stays).
+
+The reading rules are docs/names.md; split_name below is a copy of staffdir.names.split_name,
+because a migration does not import the application.
+"""
+
+PARTICLES = frozenset({"van", "von", "der", "den", "de", "del", "della", "di", "da", "du", "la", "le", "bin", "ibn"})
+
+
+def split_name(raw):
+    text = " ".join((raw or "").split())
+    if not text:
+        return "", ""
+    if "," in text:
+        left, _, right = text.partition(",")
+        left, right = left.strip(), right.strip()
+        if left and right:
+            return right, left
+        text = left or right
+        if not text:
+            return "", ""
+    words = text.split(" ")
+    if len(words) == 1:
+        return words[0], ""
+    start = len(words) - 1
+    while start > 1 and words[start - 1].casefold() in PARTICLES:
+        start -= 1
+    return " ".join(words[:start]), " ".join(words[start:])
+
+
+def up(conn):
+    columns = {row[1] for row in conn.execute("PRAGMA table_info(users)")}
+    for column in ("given_name", "family_name"):
+        if column not in columns:
+            conn.execute(f"ALTER TABLE users ADD COLUMN {column} TEXT")
+
+    # Only rows that were never split: a value corrected by hand since stays as it is.
+    todo = conn.execute("SELECT id, full_name FROM users WHERE given_name IS NULL AND family_name IS NULL").fetchall()
+    for user_id, full_name in todo:
+        given, family = split_name(full_name)
+        conn.execute("UPDATE users SET given_name = ?, family_name = ? WHERE id = ?", (given, family, user_id))
+
+    conn.execute("CREATE INDEX IF NOT EXISTS users_name ON users (family_name COLLATE NOCASE, given_name COLLATE NOCASE)")
+
+    # The roster view reads the new columns (and still carries the old one for rows not split yet).
+    conn.execute("DROP VIEW IF EXISTS team_roster")
+    conn.execute(
+        "CREATE VIEW team_roster AS"
+        " SELECT u.id AS user_id, u.team_id AS team_id, u.given_name AS given_name,"
+        " u.family_name AS family_name, u.full_name AS full_name, u.email AS email, u.status AS status"
+        " FROM users u WHERE u.team_id IS NOT NULL"
+    )
