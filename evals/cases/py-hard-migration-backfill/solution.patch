index 0000000..17141d2
--- /dev/null
+++ b/tests/test_names.py
@@ -0,0 +1,47 @@
+import pytest
+
+from staffdir import names
+
+CASES = [
+    ("Ada Lovelace", ("Ada", "Lovelace")),
+    ("Cher", ("Cher", "")),
+    ("Mary Jane Watson", ("Mary Jane", "Watson")),
+    ("  Mary   Jane \t Watson\n", ("Mary Jane", "Watson")),
+    ("Mary Jane Watson", ("Mary Jane", "Watson")),
+    ("Watson, Mary Jane", ("Mary Jane", "Watson")),
+    ("Watson,Mary", ("Mary", "Watson")),
+    ("van der Berg, Vincent", ("Vincent", "van der Berg")),
+    ("Ludwig van Beethoven", ("Ludwig", "van Beethoven")),
+    ("Vincent Van Der Berg", ("Vincent", "Van Der Berg")),
+    ("Anna Maria de la Cruz", ("Anna Maria", "de la Cruz")),
+    ("van Halen", ("van", "Halen")),
+    ("Jan de", ("Jan", "de")),
+    ("Watson,", ("Watson", "")),
+    (",Mary", ("Mary", "")),
+    (None, ("", "")),
+    ("", ("", "")),
+    ("   ", ("", "")),
+    ("José Álvarez", ("José", "Álvarez")),
+    ("李　小龍", ("李", "小龍")),
+    ("李小龍", ("李小龍", "")),
+    ("José Alvarez", ("José", "Alvarez")),
+]
+
+
+@pytest.mark.parametrize("text,expected", CASES)
+def test_split_name(text, expected):
+    assert names.split_name(text) == expected
+
+
+def test_display_name_leaves_out_an_empty_part():
+    assert names.display_name("Mary Jane", "Watson") == "Mary Jane Watson"
+    assert names.display_name("Cher", "") == "Cher"
+    assert names.display_name("", "Watson") == "Watson"
+    assert names.display_name(None, None) == ""
+
+
+def test_resolve_prefers_the_columns_and_falls_back_to_full_name():
+    row = {"given_name": "Zed", "family_name": "Quill", "full_name": "Ada Lovelace"}
+    assert names.resolve(row) == ("Zed", "Quill")
+    assert names.resolve({"given_name": None, "family_name": None, "full_name": "Watson, Mary"}) == ("Mary", "Watson")
+    assert names.resolve({"given_name": "Cher", "family_name": None, "full_name": "x"}) == ("Cher", "")
