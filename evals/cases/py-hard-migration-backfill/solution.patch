diff --git a/tests/test_split_names_migration.py b/tests/test_split_names_migration.py
new file mode 100644
index 0000000..d28833b
--- /dev/null
+++ b/tests/test_split_names_migration.py
@@ -0,0 +1,80 @@
+"""0007_split_user_names against a database at the schema of 0006."""
+import shutil
+
+import pytest
+
+from staffdir import db, migrate, users
+
+ROWS = [
+    ("Ada Lovelace", "ada@example.com"),
+    ("  Watson,  Mary Jane ", "mary@example.com"),
+    ("Cher", "cher@example.com"),
+    ("", "empty@example.com"),
+    (None, "null@example.com"),
+]
+
+
+@pytest.fixture
+def old_db(tmp_path):
+    older = tmp_path / "older"
+    older.mkdir()
+    for migration in migrate.discover():
+        if migration.version < "0007":
+            shutil.copy(migration.path, older / migration.path.name)
+    conn = db.connect(str(tmp_path / "old.db"))
+    migrate.run(conn, older)
+    for full_name, email in ROWS:
+        conn.execute("INSERT INTO users (full_name, email) VALUES (?, ?)", (full_name, email))
+    conn.commit()
+    return conn
+
+
+def parts(conn):
+    rows = conn.execute("SELECT email, given_name, family_name, full_name FROM users ORDER BY id")
+    return [tuple(row) for row in rows]
+
+
+def test_backfill_fills_every_row_and_keeps_full_name(old_db):
+    assert migrate.run(old_db) == ["0007"]
+    assert parts(old_db) == [
+        ("ada@example.com", "Ada", "Lovelace", "Ada Lovelace"),
+        ("mary@example.com", "Mary Jane", "Watson", "  Watson,  Mary Jane "),
+        ("cher@example.com", "Cher", "", "Cher"),
+        ("empty@example.com", "", "", ""),
+        ("null@example.com", "", "", None),
+    ]
+
+
+def test_running_it_again_changes_nothing_and_keeps_corrections(old_db):
+    migrate.run(old_db)
+    old_db.execute("UPDATE users SET given_name = 'Augusta Ada' WHERE email = 'ada@example.com'")
+    old_db.commit()
+    before = parts(old_db)
+    old_db.execute("DELETE FROM schema_migrations WHERE version = '0007'")
+    old_db.commit()
+    assert migrate.run(old_db) == ["0007"]
+    assert parts(old_db) == before
+
+
+def test_rows_the_old_release_wrote_are_filled_by_the_next_run_and_read_correctly_before(old_db):
+    migrate.run(old_db)
+    old_db.execute("INSERT INTO users (full_name, email) VALUES ('Grace Brewster Hopper', 'grace@example.com')")
+    old_db.commit()
+    grace = users.get_by_email(old_db, "grace@example.com")
+    assert (grace["given_name"], grace["family_name"]) == ("Grace Brewster", "Hopper")
+    assert old_db.execute("SELECT given_name FROM users WHERE email = 'grace@example.com'").fetchone()[0] is None
+    old_db.execute("DELETE FROM schema_migrations WHERE version = '0007'")
+    old_db.commit()
+    migrate.run(old_db)
+    row = old_db.execute("SELECT given_name, family_name FROM users WHERE email = 'grace@example.com'").fetchone()
+    assert tuple(row) == ("Grace Brewster", "Hopper")
+
+
+def test_the_roster_view_reads_the_new_columns(old_db):
+    old_db.execute("INSERT INTO teams (name) VALUES ('Platform')")
+    old_db.execute("UPDATE users SET team_id = 1 WHERE email = 'ada@example.com'")
+    old_db.commit()
+    migrate.run(old_db)
+    old_db.execute("UPDATE users SET given_name = 'Zed' WHERE email = 'ada@example.com'")
+    row = old_db.execute("SELECT given_name, family_name FROM team_roster").fetchone()
+    assert tuple(row) == ("Zed", "Lovelace")
