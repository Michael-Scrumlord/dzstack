new file mode 100644
index 0000000..c354722
--- /dev/null
+++ b/staffdir/names.py
@@ -0,0 +1,47 @@
+"""Names: reading one string as a given and a family name, and putting them back together.
+
+The rules are in docs/names.md. The backfill migration carries its own copy of split_name
+(a migration must not import the application), so change both together.
+"""
+from __future__ import annotations
+
+PARTICLES = frozenset({"van", "von", "der", "den", "de", "del", "della", "di", "da", "du", "la", "le", "bin", "ibn"})
+
+
+def clean_part(value) -> str:
+    """One part of a name: trimmed, inner whitespace collapsed to single spaces."""
+    return " ".join((value or "").split())
+
+
+def split_name(raw) -> tuple[str, str]:
+    """(given, family) for a free-text name."""
+    text = clean_part(raw)
+    if not text:
+        return "", ""
+    if "," in text:
+        left, _, right = text.partition(",")
+        left, right = left.strip(), right.strip()
+        if left and right:
+            return right, left
+        text = left or right
+        if not text:
+            return "", ""
+    words = text.split(" ")
+    if len(words) == 1:
+        return words[0], ""
+    start = len(words) - 1
+    while start > 1 and words[start - 1].casefold() in PARTICLES:
+        start -= 1
+    return " ".join(words[:start]), " ".join(words[start:])
+
+
+def display_name(given, family) -> str:
+    return " ".join(part for part in (given or "", family or "") if part)
+
+
+def resolve(row) -> tuple[str, str]:
+    """(given, family) of a users row. A row the old release wrote has NULL in both: read its full_name."""
+    given, family = row["given_name"], row["family_name"]
+    if given is None and family is None:
+        return split_name(row["full_name"])
+    return given or "", family or ""
