diff --git a/tests/test_csv_format.py b/tests/test_csv_format.py
new file mode 100644
index 0000000..baa9f8c
--- /dev/null
+++ b/tests/test_csv_format.py
@@ -0,0 +1,65 @@
+import io
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from reportly.errors import ConfigError, RowError
+from reportly.plugins import get_format
+
+from test_cli import run
+
+
+def render(columns, rows, **options):
+    out = io.StringIO()
+    get_format("csv")(**options).render(columns, rows, out)
+    return out.getvalue()
+
+
+def test_a_spreadsheet_file(columns, rows):
+    assert render(columns, rows) == (
+        "﻿Region,Amount,Units,Closed,OK\r\n"
+        "Europe,1234.50,12,2025-03-09,true\r\n"
+        "Asia | Pacific,-20.00,3,2025-03-30,false\r\n"
+        "Americas,0.5,1500,,\r\n"
+    )
+
+
+def test_it_is_registered_and_streams():
+    cls = get_format("csv")
+    assert (cls.extension, cls.streaming) == (".csv", True)
+
+
+def test_text_that_looks_like_a_formula_is_defused_but_numbers_are_not(columns):
+    out = render(columns[:2], [("=1+1", Decimal("-5")), ("-x", -5), ("@a,b", 1.5)], bom=False)
+    assert out == "Region,Amount\r\n'=1+1,-5\r\n'-x,-5\r\n\"'@a,b\",1.5\r\n"
+
+
+def test_quotes_and_line_breaks(columns):
+    out = render(columns[:1], [('say "hi"',), ("two\nlines",), ("a,b",)], bom=False, header=False)
+    assert out == '"say ""hi"""\r\n"two\nlines"\r\n"a,b"\r\n'
+
+
+def test_options(columns, rows):
+    out = render(columns[:2], [rows[0][:2]], delimiter=";", bom=False, header=False)
+    assert out == "Europe;1234.50\r\n"
+    for bad in ("", "ab", '"', "\n"):
+        with pytest.raises(ConfigError, match="delimiter"):
+            render(columns, rows, delimiter=bad)
+
+
+def test_a_short_row_is_an_error(columns, rows):
+    with pytest.raises(RowError, match="row 2"):
+        render(columns, [rows[0], rows[1][:2]])
+
+
+def test_the_command_line_and_the_config_file_select_it(write_config):
+    path = write_config('format = "csv"\n[formats.csv]\nbom = false\n')
+    code, out, _ = run("run", "sales", "--config", str(path))
+    assert code == 0 and out.startswith("Region,Amount,Units,Closed,OK\r\nEurope,1234.50,12,2025-03-09,true\r\n")
+    code, out, _ = run("run", "sales", "--config", str(path), "-f", "text")
+    assert out.startswith("Region")
+
+
+def test_the_formats_command_lists_it(write_config):
+    assert any(l.startswith("csv") and ".csv" in l for l in run("formats")[1].splitlines())
