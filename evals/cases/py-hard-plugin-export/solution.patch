+++ b/reportly/formats/csvfmt.py
@@ -0,0 +1,57 @@
+"""CSV for spreadsheets and programs. Follows "Spreadsheet formats" in docs/plugins.md."""
+from __future__ import annotations
+
+from typing import Any, Iterable, Sequence, TextIO
+
+from reportly.columns import Column
+from reportly.errors import RowError
+from reportly.formatting import machine
+from reportly.plugins import FormatBase, Option, register_format
+
+BOM = "﻿"
+# A spreadsheet reads a cell starting with one of these as a formula.
+FORMULA_STARTS = ("=", "+", "-", "@", "\t", "\r")
+
+
+def _delimiter_ok(value: str) -> None:
+    if len(value) != 1 or value in ('"', "\r", "\n"):
+        raise ValueError("must be exactly one character, and not a double quote or a line break")
+
+
+def _defuse(text: str) -> str:
+    return "'" + text if text.startswith(FORMULA_STARTS) else text
+
+
+@register_format
+class CsvFormat(FormatBase):
+    name = "csv"
+    extension = ".csv"
+    content_type = "text/csv; charset=utf-8"
+    description = "comma-separated values for spreadsheets"
+    streaming = True
+    options = {
+        "delimiter": Option(str, ",", "cell separator, one character", _delimiter_ok),
+        "bom": Option(bool, True, "start with a UTF-8 byte order mark"),
+        "header": Option(bool, True, "write the column titles first"),
+    }
+
+    def render(self, columns: Sequence[Column], rows: Iterable[Sequence[Any]], out: TextIO) -> None:
+        delimiter = self.opts["delimiter"]
+        needs_quotes = (delimiter, '"', "\r", "\n")
+
+        def line(cells: Iterable[str]) -> str:
+            quoted = ('"' + c.replace('"', '""') + '"' if any(ch in c for ch in needs_quotes) else c for c in cells)
+            return delimiter.join(quoted) + "\r\n"
+
+        def cell(value: Any) -> str:
+            text = machine(value)
+            return _defuse(text) if isinstance(value, str) else text
+
+        if self.opts["bom"]:
+            out.write(BOM)
+        if self.opts["header"]:
+            out.write(line(_defuse(c.title) for c in columns))
+        for number, row in enumerate(rows, 1):
+            if len(row) != len(columns):
+                raise RowError(number, len(columns), len(row))
+            out.write(line(cell(v) for v in row))
