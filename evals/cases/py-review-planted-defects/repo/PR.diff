diff --git a/tests/test_admin.py b/tests/test_admin.py
new file mode 100644
index 0000000..9f7867b
--- /dev/null
+++ b/tests/test_admin.py
@@ -0,0 +1,49 @@
+from datetime import date, timedelta
+
+import pytest
+
+from app import loans, members, reports
+from app.loans import LoanError
+from app.routes import handle
+
+
+def test_search_members_matches_part_of_a_name(conn):
+    members.add_member(conn, "Ada Byron", "ada@example.org")
+    members.add_member(conn, "Grace Hopper", "grace@example.org")
+    assert [m["name"] for m in members.search_members(conn, "race")] == ["Grace Hopper"]
+
+
+def test_search_route_returns_matches(conn, today):
+    members.add_member(conn, "Ada Byron", "ada@example.org")
+    status, body = handle(conn, "GET", "/members/search", {"q": "Ada"}, None, today)
+    assert status == 200 and len(body["members"]) == 1
+
+
+def test_checkout_many_makes_one_loan_per_book(conn, seeded, today):
+    member_id, book_ids = seeded
+    ids = loans.checkout_many(conn, member_id, book_ids[:3], today)
+    assert len(ids) == 3
+    assert len(loans.active_loans(conn, member_id)) == 3
+
+
+def test_checkout_many_refuses_more_than_the_limit(conn, seeded, today):
+    member_id, book_ids = seeded
+    with pytest.raises(LoanError):
+        loans.checkout_many(conn, member_id, book_ids[:6], today)
+
+
+def test_overdue_report_lists_loans_well_past_due(conn, seeded, today):
+    member_id, book_ids = seeded
+    loans.checkout(conn, member_id, book_ids[0], today - timedelta(days=30))
+    loans.checkout(conn, member_id, book_ids[1], today)
+    report = reports.overdue_loans(conn, today)
+    assert [r["title"] for r in report] == ["Book 1"]
+    assert report[0]["days_late"] == 16
+
+
+def test_overdue_report_can_be_ordered_by_title(conn, seeded, today):
+    member_id, book_ids = seeded
+    for book_id in (book_ids[2], book_ids[0]):
+        loans.checkout(conn, member_id, book_id, date(2026, 1, 1))
+    titles = [r["title"] for r in reports.overdue_loans(conn, today, order="title")]
+    assert titles == ["Book 1", "Book 3"]
