diff --git a/app/loans.py b/app/loans.py
index e275828..96b818a 100644
--- a/app/loans.py
+++ b/app/loans.py
@@ -46,3 +46,24 @@ def return_book(conn, loan_id, today):
         raise LoanError(f"loan {loan_id} is not open")
     conn.execute("UPDATE loans SET returned_on = ? WHERE id = ?", (today.isoformat(), loan_id))
     conn.commit()
+
+
+def checkout_many(conn, member_id, book_ids, today):
+    """Check out several books for one member in a single request: all of them, or none."""
+    if not book_ids:
+        raise LoanError("no books given")
+    if len(active_loans(conn, member_id)) + len(book_ids) > MAX_LOANS:
+        raise LoanError(f"member {member_id} would have more than {MAX_LOANS} books out")
+    loaned_on = today.isoformat()
+    due_on = (today + timedelta(days=LOAN_DAYS)).isoformat()
+    loan_ids = []
+    for book_id in book_ids:
+        if not is_available(conn, book_id):
+            raise LoanError(f"book {book_id} is already on loan")
+        cur = conn.execute(
+            "INSERT INTO loans (book_id, member_id, loaned_on, due_on) VALUES (?, ?, ?, ?)",
+            (book_id, member_id, loaned_on, due_on),
+        )
+        loan_ids.append(cur.lastrowid)
+    conn.commit()
+    return loan_ids
