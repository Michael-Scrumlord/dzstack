+def search_members(conn, text):
+    """Members whose name contains `text`, for the admin lookup box."""
+    sql = f"SELECT id, name, email FROM members WHERE name LIKE '%{text}%' ORDER BY name"
+    return conn.execute(sql).fetchall()
diff --git a/app/reports.py b/app/reports.py
new file mode 100644
index 0000000..ec40b37
--- /dev/null
+++ b/app/reports.py
@@ -0,0 +1,30 @@
+"""Reports for the front desk."""
+from datetime import date
+
+GRACE_DAYS = 3  # a loan is overdue once it is MORE than this many days past due
+ORDER_COLUMNS = {'due': 'l.due_on', 'member': 'm.name', 'title': 'b.title'}
+
+
+def _days_late(row, today):
+    return (today - date.fromisoformat(row['due_on'])).days
+
+
+def overdue_loans(conn, today, order='due'):
+    """Open loans that are more than GRACE_DAYS past their due date."""
+    column = ORDER_COLUMNS.get(order, 'l.due_on')
+    sql = (
+        "SELECT l.id, l.due_on, m.name AS member, b.title AS title "
+        "FROM loans l JOIN members m ON m.id = l.member_id JOIN books b ON b.id = l.book_id "
+        f"WHERE l.returned_on IS NULL ORDER BY {column}"
+    )
+    rows = conn.execute(sql).fetchall()
+    return [
+        {
+            'loan_id': row['id'],
+            'member': row['member'],
+            'title': row['title'],
+            'days_late': _days_late(row, today),
+        }
+        for row in rows
+        if _days_late(row, today) >= GRACE_DAYS
+    ]
