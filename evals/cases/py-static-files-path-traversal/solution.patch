+    relative = unquote(url_path).lstrip("/")  # always relative to root, never absolute
+    if "\0" in relative:
+        return _reply(NOT_FOUND)
+    # Resolve ".." and symlinks first: where the request really lands must be inside the real root.
+    real_root = os.path.realpath(root)
+    path = os.path.realpath(os.path.join(real_root, relative))
+    if not _inside(real_root, path):
+        return _reply(FORBIDDEN)
     if os.path.isdir(path):
