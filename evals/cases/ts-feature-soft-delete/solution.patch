+
+test("restore brings a deleted project back within 30 days", () => {
+  const { service, setTime } = setup();
+  const a = service.create({ name: "A" });
+  setTime(2000);
+  service.delete(a.id);
+  assert.deepEqual(service.list({ includeDeleted: true }).map((p) => p.deletedAt), [2000]);
+  setTime(2000 + 30 * 24 * 60 * 60 * 1000);
+  assert.equal(service.restore(a.id).deletedAt, null);
+  assert.equal(service.get(a.id).name, "A");
+});
+
+test("restore is refused after 30 days, for a live project, and when the name was taken", () => {
+  const { service, setTime } = setup();
+  const a = service.create({ name: "A" });
+  assert.throws(() => service.restore(a.id), ConflictError);
+  service.delete(a.id);
+  service.create({ name: "a" });
+  assert.throws(() => service.restore(a.id), ConflictError);
+  setTime(2000 + 30 * 24 * 60 * 60 * 1000);
+  assert.throws(() => service.restore(a.id), RestoreExpiredError);
+  assert.throws(() => service.restore("nope"), NotFoundError);
+});
