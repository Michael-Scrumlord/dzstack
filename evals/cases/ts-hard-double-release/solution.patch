diff --git a/src/platform/mutex.ts b/src/platform/mutex.ts
new file mode 100644
index 0000000..dc5d82c
--- /dev/null
+++ b/src/platform/mutex.ts
@@ -0,0 +1,19 @@
+// Runs async sections one at a time, in the order they were asked for.
+
+export interface Mutex {
+  run<T>(section: () => Promise<T>): Promise<T>;
+}
+
+export function createMutex(): Mutex {
+  let tail: Promise<void> = Promise.resolve();
+  return {
+    run(section) {
+      const result = tail.then(section);
+      tail = result.then(
+        () => undefined,
+        () => undefined,
+      );
+      return result;
+    },
+  };
+}
