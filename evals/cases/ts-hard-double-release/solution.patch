   assert.equal(await app.reservations.restoreTimers(), 1, "still active, no timer: armed again");
   assert.equal(clock.pending(), 1);
 });
+
+test("two releases of the same reservation at the same moment give the units back once", async () => {
+  const app = makeApp();
+  const r = await app.reservations.reserve({ orderId: "ord_x", sku: "WID-1", qty: 5 });
+  const results = await Promise.all([app.reservations.release(r.id, "order_cancelled"), app.reservations.release(r.id, "expired")]);
+  assert.deepEqual(results.sort(), [false, true]);
+  assert.deepEqual(app.ledger.snapshot("WID-1"), { sku: "WID-1", onHand: 20, available: 20, reserved: 0, sold: 0 });
+});
+
+test("a release that overtakes a hung one wins, and the late answer of the hung one changes nothing", async () => {
+  const gates: Array<() => void> = [];
+  const warehouse = {
+    async deallocate() {
+      if (gates.length === 0) await new Promise<void>((resolve) => gates.push(resolve)); // the first call never answers
+    },
+  };
+  const app = makeApp({ warehouse });
+  const other = await app.reservations.reserve({ orderId: "ord_y", sku: "WID-1", qty: 3 });
+  const r = await app.reservations.reserve({ orderId: "ord_x", sku: "WID-1", qty: 5 });
+  const hung = app.reservations.release(r.id, "expired");
+  await settle();
+  assert.equal(await app.reservations.release(r.id, "order_cancelled"), true);
+  gates[0]();
+  assert.equal(await hung, false);
+  assert.deepEqual(app.ledger.snapshot("WID-1"), { sku: "WID-1", onHand: 20, available: 17, reserved: 3, sold: 0 });
+  assert.equal((await app.reservations.get(other.id))?.status, "active");
+});
+
+test("a release and a commit of the same reservation cannot both succeed", async () => {
+  const app = makeApp();
+  const r = await app.reservations.reserve({ orderId: "ord_x", sku: "WID-1", qty: 5 });
+  const [released, committed] = await Promise.all([
+    app.reservations.release(r.id, "expired"),
+    app.reservations.commit(r.id).then(() => true, () => false),
+  ]);
+  assert.notEqual(released, committed);
+  const c = app.ledger.snapshot("WID-1");
+  assert.equal(c.available + c.reserved + c.sold, c.onHand);
+});
