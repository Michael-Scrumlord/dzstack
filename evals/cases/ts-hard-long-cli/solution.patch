@@ -0,0 +1,73 @@
+import { isDeepStrictEqual } from "node:util";
+import { parseOptions } from "../args.ts";
+import { parseDate } from "../dates.ts";
+import { CommandError, UsageError } from "../errors.ts";
+import { record } from "../journal.ts";
+import { findTask } from "../task.ts";
+import { MAX_TAGS, normaliseTags, parseId, parseNote, parsePriority, parseTag, parseTags, parseTitle } from "../validate.ts";
+import type { Context } from "../cli.ts";
+import type { Task } from "../task.ts";
+
+type Editable = "title" | "due" | "priority" | "note" | "tags";
+const ORDER: Editable[] = ["title", "due", "priority", "note", "tags"];
+
+/** `tasks edit <id> [--title T] [--due DATE|none] [--priority P] [--note T] [--tag T]... [--add-tag T]... [--remove-tag T]...` */
+export function edit(ctx: Context, args: string[]): number {
+  const { positionals, values, lists } = parseOptions(args, {
+    title: "string",
+    due: "string",
+    priority: "string",
+    note: "string",
+    tag: "list",
+    "add-tag": "list",
+    "remove-tag": "list",
+  });
+  if (positionals.length === 0) throw new UsageError("missing task id");
+  const id = parseId(positionals[0] as string);
+  if (positionals.length > 1) throw new UsageError(`unexpected argument "${positionals[1]}"`);
+  if (Object.keys(values).length === 0 && Object.keys(lists).length === 0) throw new UsageError("nothing to change");
+  if (lists.tag && (lists["add-tag"] || lists["remove-tag"])) {
+    throw new UsageError("--tag cannot be combined with --add-tag or --remove-tag");
+  }
+
+  const wanted: Partial<Pick<Task, Editable>> = {};
+  if (values.title !== undefined) wanted.title = parseTitle(values.title, "title must not be empty");
+  if (values.priority !== undefined) wanted.priority = parsePriority(values.priority);
+  if (values.due !== undefined) wanted.due = values.due === "none" ? null : parseDate(values.due, ctx.today());
+  if (values.note !== undefined) wanted.note = parseNote(values.note);
+  const replaceTags = lists.tag ? parseTags(lists.tag) : undefined;
+  const addTags = (lists["add-tag"] ?? []).map(parseTag);
+  const removeTags = (lists["remove-tag"] ?? []).map(parseTag);
+  const both = addTags.find((tag) => removeTags.includes(tag));
+  if (both !== undefined) throw new UsageError(`"${both}" is both added and removed`);
+
+  const store = ctx.load();
+  const task = findTask(store, id);
+  if (!task) throw new CommandError(`no task #${id}`);
+  const missing = removeTags.find((tag) => !task.tags.includes(tag));
+  if (missing !== undefined) throw new CommandError(`task #${id} has no tag "${missing}"`);
+  if (replaceTags) wanted.tags = replaceTags;
+  else if (addTags.length > 0 || removeTags.length > 0) {
+    const tags = normaliseTags([...task.tags, ...addTags].filter((tag) => !removeTags.includes(tag)));
+    if (tags.length > MAX_TAGS) throw new CommandError(`task #${id} would have more than ${MAX_TAGS} tags`);
+    wanted.tags = tags;
+  }
+
+  const before: Partial<Pick<Task, Editable>> = {};
+  const changed: Editable[] = [];
+  for (const field of ORDER) {
+    if (!(field in wanted)) continue;
+    if (isDeepStrictEqual(task[field], wanted[field])) continue;
+    (before as Record<string, unknown>)[field] = structuredClone(task[field]);
+    changed.push(field);
+  }
+  if (changed.length === 0) {
+    ctx.io.stdout(`No changes to #${id}\n`);
+    return 0;
+  }
+  for (const field of changed) (task as Record<string, unknown>)[field] = wanted[field];
+  record(store, { op: "edit", id, before });
+  ctx.save(store);
+  ctx.io.stdout(`Edited #${id} (${changed.join(", ")})\n`);
+  return 0;
+}
