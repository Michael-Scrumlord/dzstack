+
+test("add, done, edit and undo round trip", async () => {
+  const store = join(tempDir(), "tasks.json");
+  assert.equal((await cli(["--store", store, "add", "Buy", "milk", "--due", "+2d", "--tag", "Home"])).stdout, "Added #1: Buy milk (due 2026-05-03)\n");
+  assert.equal((await cli(["--store", store, "done", "1"])).stdout, "Done #1: Buy milk\n");
+  assert.equal((await cli(["--store", store, "edit", "1", "--priority", "high"])).stdout, "Edited #1 (priority)\n");
+  assert.equal((await cli(["--store", store, "undo"])).stdout, "Undid edit #1: Buy milk\n");
+  assert.equal((await cli(["--store", store, "undo"])).stdout, "Undid done #1: Buy milk\n");
+  assert.equal(readStoreFile(store).tasks[0]?.status, "open");
+  assert.equal((await cli(["--store", store, "undo"])).stdout, "Undid add #1: Buy milk\n");
+  assert.deepEqual((await cli(["--store", store, "undo"])).stderr, "tasks: undo: nothing to undo\n");
