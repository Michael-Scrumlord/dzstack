diff --git a/src/validate.ts b/src/validate.ts
new file mode 100644
index 0000000..0040523
--- /dev/null
+++ b/src/validate.ts
@@ -0,0 +1,52 @@
+import { UsageError } from "./errors.ts";
+import { PRIORITIES } from "./task.ts";
+import type { Priority } from "./task.ts";
+
+export const MAX_TITLE = 80;
+export const MAX_NOTE = 500;
+export const MAX_TAGS = 10;
+const TAG = /^[a-z0-9][a-z0-9_-]{0,19}$/;
+const ID = /^[1-9][0-9]*$/;
+
+export function parseId(text: string): number {
+  if (!ID.test(text) || !Number.isSafeInteger(Number(text))) throw new UsageError(`invalid id "${text}"`);
+  return Number(text);
+}
+
+export function parsePriority(text: string): Priority {
+  if (!PRIORITIES.includes(text as Priority)) {
+    throw new UsageError(`invalid priority "${text}" (expected high, normal or low)`);
+  }
+  return text as Priority;
+}
+
+export function parseTag(text: string): string {
+  const tag = text.trim().toLowerCase();
+  if (!TAG.test(tag)) throw new UsageError(`invalid tag "${text}"`);
+  return tag;
+}
+
+/** Normalised tags without repeats, in ascending order. */
+export function normaliseTags(tags: string[]): string[] {
+  return [...new Set(tags)].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+}
+
+export function parseTags(texts: string[]): string[] {
+  const tags = normaliseTags(texts.map(parseTag));
+  if (tags.length > MAX_TAGS) throw new UsageError(`a task has at most ${MAX_TAGS} tags`);
+  return tags;
+}
+
+export function parseTitle(text: string, emptyMessage: string): string {
+  const title = text.trim();
+  if (title === "") throw new UsageError(emptyMessage);
+  if (title.length > MAX_TITLE) throw new UsageError(`title is longer than ${MAX_TITLE} characters`);
+  return title;
+}
+
+/** The note, or null for an empty one. */
+export function parseNote(text: string): string | null {
+  const note = text.trim();
+  if (note.length > MAX_NOTE) throw new UsageError(`note is longer than ${MAX_NOTE} characters`);
+  return note === "" ? null : note;
+}
