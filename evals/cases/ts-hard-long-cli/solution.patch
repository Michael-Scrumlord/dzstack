@@ -0,0 +1,54 @@
+import { UsageError } from "./errors.ts";
+
+const ISO = /^(\d{4})-(\d{2})-(\d{2})$/;
+const RELATIVE = /^([+-])(\d{1,4})([dw])$/;
+const DAY_MS = 86_400_000;
+export const DATE_HELP = "YYYY-MM-DD, today, tomorrow, yesterday, +Nd, -Nd, +Nw or -Nw";
+
+/** Days since 1970-01-01 for a real YYYY-MM-DD date with a year from 1000 to 9999, else undefined. */
+export function isoToDays(iso: string): number | undefined {
+  const match = ISO.exec(iso);
+  if (!match) return undefined;
+  const [year, month, day] = [Number(match[1]), Number(match[2]), Number(match[3])];
+  if (year < 1000) return undefined;
+  const ms = Date.UTC(year, month - 1, day);
+  const back = new Date(ms);
+  if (back.getUTCFullYear() !== year || back.getUTCMonth() !== month - 1 || back.getUTCDate() !== day) return undefined;
+  return ms / DAY_MS;
+}
+
+export function daysToIso(days: number): string | undefined {
+  const date = new Date(days * DAY_MS);
+  const year = date.getUTCFullYear();
+  if (year < 1000 || year > 9999) return undefined;
+  return date.toISOString().slice(0, 10);
+}
+
+export function addDays(iso: string, days: number): string {
+  const result = daysToIso((isoToDays(iso) as number) + days);
+  if (result === undefined) throw new RangeError(`date out of range: ${iso} + ${days} days`);
+  return result;
+}
+
+/** Reads a date argument (see docs/SPEC.md, "Dates") relative to `today`. */
+export function parseDate(text: string, today: string): string {
+  const fail = () => new UsageError(`invalid date "${text}" (expected ${DATE_HELP})`);
+  if (ISO.test(text)) {
+    if (isoToDays(text) === undefined) throw fail();
+    return text;
+  }
+  const base = isoToDays(today);
+  if (base === undefined) throw new UsageError("TASKS_TODAY must be a date like 2026-05-01");
+  const shift = (days: number) => daysToIso(base + days) ?? undefined;
+  let result: string | undefined;
+  if (text === "today") result = today;
+  else if (text === "tomorrow") result = shift(1);
+  else if (text === "yesterday") result = shift(-1);
+  else {
+    const match = RELATIVE.exec(text);
+    if (!match) throw fail();
+    result = shift(Number(match[2]) * (match[3] === "w" ? 7 : 1) * (match[1] === "-" ? -1 : 1));
+  }
+  if (result === undefined) throw fail();
+  return result;
+}
