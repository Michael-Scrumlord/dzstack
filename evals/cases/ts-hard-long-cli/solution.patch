diff --git a/src/commands/report.ts b/src/commands/report.ts
new file mode 100644
index 0000000..3ae5431
--- /dev/null
+++ b/src/commands/report.ts
@@ -0,0 +1,69 @@
+import { parseOptions } from "../args.ts";
+import { addDays, parseDate } from "../dates.ts";
+import { UsageError } from "../errors.ts";
+import { PRIORITIES, priorityRank } from "../task.ts";
+import { parsePriority, parseTag } from "../validate.ts";
+import type { Context } from "../cli.ts";
+import type { Priority, Task } from "../task.ts";
+
+const byUrgency = (a: Task, b: Task) =>
+  (a.due as string).localeCompare(b.due as string) || priorityRank(a.priority) - priorityRank(b.priority) || a.id - b.id;
+
+function taskLine(task: Task): string {
+  const tags = task.tags.length > 0 ? ` [${task.tags.join(",")}]` : "";
+  return `  #${task.id} ${task.due} ${task.priority} ${task.title}${tags}`;
+}
+
+/** `tasks report [--format text|json] [--tag TAG] [--priority P] [--since DATE]` */
+export function report(ctx: Context, args: string[]): number {
+  const { positionals, values } = parseOptions(args, { format: "string", tag: "string", priority: "string", since: "string" });
+  if (positionals.length > 0) throw new UsageError(`unexpected argument "${positionals[0]}"`);
+  const format = values.format ?? "text";
+  if (format !== "text" && format !== "json") throw new UsageError(`invalid format "${format}" (expected text or json)`);
+  const tag = values.tag === undefined ? null : parseTag(values.tag);
+  const priority: Priority | null = values.priority === undefined ? null : parsePriority(values.priority);
+  const today = ctx.today();
+  const since = values.since === undefined ? null : parseDate(values.since, today);
+
+  const store = ctx.load();
+  const selected = store.tasks.filter(
+    (task) => (tag === null || task.tags.includes(tag)) && (priority === null || task.priority === priority) && (since === null || task.createdAt >= since),
+  );
+  const open = selected.filter((task) => task.status === "open");
+  const done = selected.filter((task) => task.status === "done");
+  const overdue = open.filter((task) => task.due !== null && task.due < today).sort(byUrgency);
+  const horizon = addDays(today, 7);
+  const dueSoon = open.filter((task) => task.due !== null && task.due >= today && task.due <= horizon).sort(byUrgency);
+  const openByPriority = Object.fromEntries(PRIORITIES.map((p) => [p, open.filter((task) => task.priority === p).length]));
+  const windowStart = addDays(today, -6);
+  const completedRecently = done.filter((task) => task.completedAt !== null && task.completedAt >= windowStart && task.completedAt <= today);
+
+  if (format === "json") {
+    const result = {
+      date: today,
+      filter: { tag, priority, since },
+      total: selected.length,
+      open: open.length,
+      done: done.length,
+      overdue: overdue.map((task) => task.id),
+      dueSoon: dueSoon.map((task) => task.id),
+      openByPriority,
+      completedLast7Days: completedRecently.length,
+    };
+    ctx.io.stdout(`${JSON.stringify(result, null, 2)}\n`);
+    return 0;
+  }
+
+  const lines = [`Report for ${today}`];
+  const filters = [tag && `tag=${tag}`, priority && `priority=${priority}`, since && `since=${since}`].filter(Boolean);
+  if (filters.length > 0) lines.push(`Filter: ${filters.join(", ")}`);
+  lines.push(`Tasks: ${selected.length} (open ${open.length}, done ${done.length})`);
+  for (const [heading, tasks] of [["Overdue", overdue], ["Due in the next 7 days", dueSoon]] as const) {
+    lines.push(`${heading} (${tasks.length}):`);
+    lines.push(...(tasks.length > 0 ? tasks.map(taskLine) : ["  none"]));
+  }
+  lines.push(`Open by priority: ${PRIORITIES.map((p) => `${p} ${openByPriority[p]}`).join(", ")}`);
+  lines.push(`Completed in the last 7 days: ${completedRecently.length}`);
+  ctx.io.stdout(`${lines.join("\n")}\n`);
+  return 0;
+}
