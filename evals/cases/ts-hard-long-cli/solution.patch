+/**
+ * Writes the store file: two-space JSON and a final newline. The text goes to a temp file next
+ * to the store and is renamed over it, so a failure or a crash never leaves a half-written store.
+ */
 export function writeStore(path: string, store: Store, fs: FsApi): void {
   const text = `${JSON.stringify(store, null, 2)}\n`;
+  const temp = `${path}.${process.pid}.tmp`;
   try {
