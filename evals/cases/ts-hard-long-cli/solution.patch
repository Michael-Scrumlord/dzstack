+const HOOKED = ["readFileSync", "writeFileSync", "renameSync", "unlinkSync"] as const;
+
+/** node:fs, with the functions TASKS_FS_HOOK's module exports in place of the ones of the same name. */
+export async function loadFsApi(env: NodeJS.ProcessEnv): Promise<FsApi> {
+  const hook = env.TASKS_FS_HOOK;
+  if (!hook) return nodeFs;
+  const module = (await import(pathToFileURL(hook).href)) as Record<string, unknown>;
+  const api: Record<string, unknown> = { ...nodeFs };
+  for (const name of HOOKED) if (typeof module[name] === "function") api[name] = module[name];
+  return api as unknown as FsApi;
