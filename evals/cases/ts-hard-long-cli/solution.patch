@@ -0,0 +1,40 @@
+import { parseOptions } from "../args.ts";
+import { CommandError, UsageError } from "../errors.ts";
+import { record } from "../journal.ts";
+import { findTask } from "../task.ts";
+import { parseId } from "../validate.ts";
+import type { Context } from "../cli.ts";
+
+/** `tasks done <id>...` */
+export function done(ctx: Context, args: string[]): number {
+  const { positionals } = parseOptions(args, {});
+  if (positionals.length === 0) throw new UsageError("missing task id");
+  const ids = [...new Set(positionals.map(parseId))];
+
+  const store = ctx.load();
+  const tasks = ids.map((id) => {
+    const task = findTask(store, id);
+    if (!task) throw new CommandError(`no task #${id}`);
+    return task;
+  });
+
+  const today = ctx.today();
+  const lines: string[] = [];
+  const changed: number[] = [];
+  for (const task of tasks) {
+    if (task.status === "done") {
+      lines.push(`Task #${task.id} is already done`);
+      continue;
+    }
+    task.status = "done";
+    task.completedAt = today;
+    changed.push(task.id);
+    lines.push(`Done #${task.id}: ${task.title}`);
+  }
+  if (changed.length > 0) {
+    record(store, { op: "done", ids: changed });
+    ctx.save(store);
+  }
+  ctx.io.stdout(lines.map((line) => `${line}\n`).join(""));
+  return 0;
+}
