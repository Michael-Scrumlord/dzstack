@@ -0,0 +1,39 @@
+import { parseOptions } from "../args.ts";
+import { CommandError, UsageError } from "../errors.ts";
+import { findTask } from "../task.ts";
+import type { Context } from "../cli.ts";
+import type { Task } from "../task.ts";
+
+/** `tasks undo`: takes back the newest journal entry. */
+export function undo(ctx: Context, args: string[]): number {
+  const { positionals } = parseOptions(args, {});
+  if (positionals.length > 0) throw new UsageError(`unexpected argument "${positionals[0]}"`);
+
+  const store = ctx.load();
+  const entry = store.journal.pop();
+  if (!entry) throw new CommandError("nothing to undo");
+
+  const lines: string[] = [];
+  if (entry.op === "add") {
+    const task = findTask(store, entry.id);
+    store.tasks = store.tasks.filter((t) => t.id !== entry.id);
+    lines.push(`Undid add #${entry.id}: ${task?.title ?? ""}`);
+  } else if (entry.op === "done") {
+    for (const id of entry.ids) {
+      const task = findTask(store, id);
+      if (!task) continue;
+      task.status = "open";
+      task.completedAt = null;
+      lines.push(`Undid done #${id}: ${task.title}`);
+    }
+  } else {
+    const task = findTask(store, entry.id);
+    if (task) {
+      Object.assign(task, structuredClone(entry.before) as Partial<Task>);
+      lines.push(`Undid edit #${entry.id}: ${task.title}`);
+    }
+  }
+  ctx.save(store);
+  ctx.io.stdout(lines.map((line) => `${line}\n`).join(""));
+  return 0;
+}
