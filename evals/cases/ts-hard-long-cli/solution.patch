@@ -0,0 +1,9 @@
+import type { JournalEntry, Store } from "./task.ts";
+
+export const JOURNAL_LIMIT = 10;
+
+/** Adds an entry to the store's journal, dropping the oldest ones beyond the limit. */
+export function record(store: Store, entry: JournalEntry): void {
+  store.journal.push(entry);
+  if (store.journal.length > JOURNAL_LIMIT) store.journal.splice(0, store.journal.length - JOURNAL_LIMIT);
+}
