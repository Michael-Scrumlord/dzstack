@@ -0,0 +1,35 @@
+import { parseOptions } from "../args.ts";
+import { parseDate } from "../dates.ts";
+import { record } from "../journal.ts";
+import { parseNote, parsePriority, parseTags, parseTitle } from "../validate.ts";
+import type { Context } from "../cli.ts";
+import type { Task } from "../task.ts";
+
+/** `tasks add <title...> [--due DATE] [--priority P] [--tag TAG]... [--note TEXT]` */
+export function add(ctx: Context, args: string[]): number {
+  const { positionals, values, lists } = parseOptions(args, { due: "string", priority: "string", tag: "list", note: "string" });
+  const title = parseTitle(positionals.join(" "), "missing title");
+  const priority = values.priority === undefined ? "normal" : parsePriority(values.priority);
+  const due = values.due === undefined ? null : parseDate(values.due, ctx.today());
+  const tags = parseTags(lists.tag ?? []);
+  const note = values.note === undefined ? null : parseNote(values.note);
+
+  const store = ctx.load();
+  const task: Task = {
+    id: store.nextId,
+    title,
+    status: "open",
+    priority,
+    due,
+    tags,
+    note,
+    createdAt: ctx.today(),
+    completedAt: null,
+  };
+  store.nextId += 1;
+  store.tasks.push(task);
+  record(store, { op: "add", id: task.id });
+  ctx.save(store);
+  ctx.io.stdout(`Added #${task.id}: ${task.title}${due ? ` (due ${due})` : ""}\n`);
+  return 0;
+}
