+/** A bug guard: the store was asked to save over a version it no longer holds. */
+export class StaleVersionError extends Error {
+  constructor(id: string) {
+    super(`document ${id} was saved from an out-of-date version`);
+    this.name = "StaleVersionError";
+  }
+}
+
+/** A save touched a field somebody else changed after the version it was based on. */
+export class VersionConflictError extends ConflictError {
+  readonly current: DocumentRecord;
+  readonly conflictingFields: string[];
+
+  constructor(current: DocumentRecord, conflictingFields: string[]) {
+    super(`${conflictingFields.join(", ")} changed after the version you saved from; the document is at version ${current.version}. Look at it and save again`);
+    this.current = current;
+    this.conflictingFields = conflictingFields;
+  }
+
+  get currentVersion(): number {
+    return this.current.version;
+  }
+}
