diff --git a/test/concurrency.test.ts b/test/concurrency.test.ts
new file mode 100644
index 0000000..90b62f9
--- /dev/null
+++ b/test/concurrency.test.ts
@@ -0,0 +1,138 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "../src/app.ts";
+import { createMemoryPersistence } from "../src/persistence.ts";
+import { as, bodyOf, createDoc, makeApp } from "./helpers.ts";
+
+async function sharedDoc(app = makeApp()) {
+  const id = await createDoc(app, "alice", { title: "Plan", body: "Draft", tags: ["a"] });
+  await as(app, "alice")("POST", `/documents/${id}/share`, { userId: "bob", role: "editor" });
+  await as(app, "alice")("POST", `/documents/${id}/share`, { userId: "carol", role: "editor" });
+  return { app, id, base: 3 };
+}
+
+test("a stale save that touches other fields is merged", async () => {
+  const { app, id, base } = await sharedDoc();
+  await as(app, "bob")("PATCH", `/documents/${id}`, { baseVersion: base, fields: { title: "Plan v2" } });
+  const response = await as(app, "carol")("PATCH", `/documents/${id}`, { baseVersion: base, fields: { body: "Draft v2" } });
+  assert.equal(response.status, 200);
+  const { document } = bodyOf(response);
+  assert.deepEqual([document.title, document.body, document.version], ["Plan v2", "Draft v2", base + 2]);
+});
+
+test("a stale save on a field somebody else changed is a 409 that can be retried", async () => {
+  const { app, id, base } = await sharedDoc();
+  await as(app, "bob")("PATCH", `/documents/${id}`, { baseVersion: base, fields: { title: "Bob's title" } });
+  const rejected = await as(app, "carol")("PATCH", `/documents/${id}`, { baseVersion: base, fields: { title: "Carol's title", body: "x" } });
+  assert.equal(rejected.status, 409);
+  const body = bodyOf(rejected);
+  assert.equal(body.error, "conflict");
+  assert.equal(body.currentVersion, base + 1);
+  assert.deepEqual(body.conflictingFields, ["title"]);
+  assert.equal(body.document.title, "Bob's title");
+  assert.equal(app.audit.entries({ documentId: id }).length, 4);
+  const retry = await as(app, "carol")("PATCH", `/documents/${id}`, {
+    baseVersion: body.currentVersion,
+    fields: { title: "Carol's title", body: "x" },
+  });
+  assert.equal(retry.status, 200);
+  assert.equal(bodyOf(retry).document.version, base + 2);
+});
+
+test("a change only counts as made after baseVersion when its version is higher", async () => {
+  const { app, id, base } = await sharedDoc();
+  await as(app, "bob")("PATCH", `/documents/${id}`, { baseVersion: base, fields: { title: "T" } }); // base + 1
+  await as(app, "bob")("PATCH", `/documents/${id}`, { baseVersion: base + 1, fields: { body: "B" } }); // base + 2
+  const seen = await as(app, "carol")("PATCH", `/documents/${id}`, { baseVersion: base + 1, fields: { title: "Newer" } });
+  assert.equal(seen.status, 200); // the title changed in version base + 1, which carol had seen
+  const stale = await as(app, "carol")("PATCH", `/documents/${id}`, { baseVersion: base + 1, fields: { body: "C" } });
+  assert.equal(stale.status, 409);
+  assert.deepEqual(bodyOf(stale).conflictingFields, ["body"]);
+});
+
+test("saving the value a field already has changes nothing", async () => {
+  const { app, id, base } = await sharedDoc();
+  const response = await as(app, "bob")("PATCH", `/documents/${id}`, { baseVersion: base, fields: { tags: ["a"], title: "Plan" } });
+  assert.equal(response.status, 200);
+  assert.equal(bodyOf(response).document.version, base);
+  assert.equal(app.audit.entries({ documentId: id }).length, 3);
+  await as(app, "bob")("PATCH", `/documents/${id}`, { baseVersion: base, fields: { tags: ["a", "b"] } });
+  const same = await as(app, "carol")("PATCH", `/documents/${id}`, { baseVersion: base, fields: { tags: ["a", "b"], body: "mine" } });
+  assert.equal(same.status, 200);
+  assert.deepEqual(app.audit.entries({ documentId: id }).at(-1)?.fields, { body: "mine" });
+});
+
+test("a base version from the future is refused", async () => {
+  const { app, id, base } = await sharedDoc();
+  const response = await as(app, "bob")("PATCH", `/documents/${id}`, { baseVersion: base + 1, fields: { title: "x" } });
+  assert.equal(response.status, 400);
+  assert.equal(bodyOf(response).error, "invalid_base_version");
+});
+
+test("two edits at the same time with slow persistence both survive", async () => {
+  const persistence = createMemoryPersistence({ latencyMs: 5 });
+  const app = createApp({ persistence });
+  const id = await createDoc(app, "alice");
+  await as(app, "alice")("POST", `/documents/${id}/share`, { userId: "bob", role: "editor" });
+  const [one, two] = await Promise.all([
+    as(app, "alice")("PATCH", `/documents/${id}`, { baseVersion: 2, fields: { title: "From alice" } }),
+    as(app, "bob")("PATCH", `/documents/${id}`, { baseVersion: 2, fields: { body: "From bob" } }),
+  ]);
+  assert.deepEqual([one.status, two.status], [200, 200]);
+  const { document } = bodyOf(await as(app, "alice")("GET", `/documents/${id}`));
+  assert.deepEqual([document.title, document.body, document.version], ["From alice", "From bob", 4]);
+  assert.equal(persistence.dump()[0]?.version, 4);
+  assert.equal(app.audit.entries({ documentId: id }).filter((e) => e.action === "edit").length, 2);
+});
+
+test("a share and an edit at the same time both take effect", async () => {
+  const persistence = createMemoryPersistence({ latencyMs: 3 });
+  const app = createApp({ persistence });
+  const id = await createDoc(app, "alice");
+  const [shared, edited] = await Promise.all([
+    as(app, "alice")("POST", `/documents/${id}/share`, { userId: "dave", role: "viewer" }),
+    as(app, "alice")("PATCH", `/documents/${id}`, { baseVersion: 1, fields: { title: "Edited" } }),
+  ]);
+  assert.deepEqual([shared.status, edited.status], [200, 200]);
+  assert.equal((await as(app, "dave")("GET", `/documents/${id}`)).status, 200);
+  assert.equal(bodyOf(await as(app, "alice")("GET", `/documents/${id}`)).document.title, "Edited");
+});
+
+test("edits to different documents do not wait for each other", async () => {
+  const app = makeApp();
+  const slow = await createDoc(app, "alice");
+  const quick = await createDoc(app, "alice");
+  const order: string[] = [];
+  await Promise.all([
+    as(app, "alice")("PATCH", `/documents/${slow}`, { baseVersion: 1, fields: { title: "s" } }).then(() => order.push("slow")),
+    as(app, "alice")("PATCH", `/documents/${quick}`, { baseVersion: 1, fields: { title: "q" } }).then(() => order.push("quick")),
+  ]);
+  assert.equal(order.length, 2);
+});
+
+test("a failing save leaves no trace and can be retried", async () => {
+  let fail = false;
+  const inner = createMemoryPersistence();
+  const persistence = {
+    ...inner,
+    async save(record: Parameters<typeof inner.save>[0]) {
+      if (fail) {
+        const { PersistenceError } = await import("../src/errors.ts");
+        throw new PersistenceError("disk full");
+      }
+      return inner.save(record);
+    },
+  };
+  const app = createApp({ persistence });
+  const id = await createDoc(app, "alice");
+  fail = true;
+  const failed = await as(app, "alice")("PATCH", `/documents/${id}`, { baseVersion: 1, fields: { title: "Lost" } });
+  assert.equal(failed.status, 503);
+  assert.equal(bodyOf(failed).error, "storage_unavailable");
+  assert.equal(bodyOf(await as(app, "alice")("GET", `/documents/${id}`)).document.title, "Plan");
+  assert.equal(app.audit.entries().length, 1);
+  assert.deepEqual(bodyOf(await as(app, "alice")("GET", "/search", undefined, { q: "lost" })).results, []);
+  fail = false;
+  const retried = await as(app, "alice")("PATCH", `/documents/${id}`, { baseVersion: 1, fields: { title: "Kept" } });
+  assert.equal(bodyOf(retried).document.version, 2);
+});
