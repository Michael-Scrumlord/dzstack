+++ b/test/projects-list-queries.test.ts
@@ -0,0 +1,34 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "../src/api/app.ts";
+import { client } from "../testkit/client.ts";
+import { generateTeam } from "../testkit/generate.ts";
+
+// docs/performance.md: at most 12 queries per list request, whatever the page size or team size,
+// and a page of 50 costs under 150 ms simulated.
+const MAX_QUERIES = 12;
+const MAX_MS = 150;
+
+for (const token of ["tok-owner", "tok-member", "tok-guest"]) {
+  for (const perPage of ["5", "50", "100"]) {
+    test(`GET /projects as ${token}, ${perPage} per page, stays within the query budget`, async () => {
+      const db = generateTeam({ projects: 400 });
+      const api = client(createApp(db), token);
+      for (const page of ["1", "2"]) {
+        db.resetStats();
+        const res = await api.get("/projects", { page, perPage });
+        assert.equal(res.status, 200);
+        assert.ok(db.stats.queries <= MAX_QUERIES, `${db.stats.queries} queries\n${db.log.slice(0, 20).join("\n")}`);
+        assert.ok(db.stats.simulatedMs < MAX_MS, `${db.stats.simulatedMs} ms simulated`);
+      }
+    });
+  }
+}
+
+test("a filtered, searched, sorted page stays within the budget too", async () => {
+  const db = generateTeam({ projects: 400 });
+  const api = client(createApp(db), "tok-member");
+  db.resetStats();
+  await api.get("/projects", { q: "a", tag: "atlas-0", sort: "updated", order: "desc", includeArchived: "true" });
+  assert.ok(db.stats.queries <= MAX_QUERIES, db.log.join("\n"));
+});
