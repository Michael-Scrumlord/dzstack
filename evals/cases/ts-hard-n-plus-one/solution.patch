+
+/** The same rule as canSeeProject in services/permissions.ts, as a filter the database applies. */
+function visibleTo(viewer: Viewer): Filter {
+  const belongsTo: Filter = {
+    id: { inSelect: { table: "project_members", column: "project_id", where: { user_id: viewer.userId } } },
+  };
+  if (isOrgAdmin(viewer)) return { org_id: viewer.orgId };
+  if (viewer.role === "member") return { org_id: viewer.orgId, $or: [{ visibility: "org" }, belongsTo] };
+  return { org_id: viewer.orgId, ...belongsTo };
+}
+
+function listFilter(viewer: Viewer, query: ListQuery): Filter {
+  const all: Filter[] = [visibleTo(viewer)];
+  if (!query.includeArchived) all.push({ archived: false });
+  if (query.q) {
+    const pattern = `%${escapeLike(query.q)}%`;
+    all.push({ $or: [{ name: { ilike: pattern } }, { key: { ilike: pattern } }] });
+  }
+  if (query.tag) {
+    const liveTagsWithLabel: Filter = { archived: false, label: { ilike: escapeLike(query.tag) } };
+    all.push({
+      id: {
+        inSelect: {
+          table: "project_tags",
+          column: "project_id",
+          where: { tag_id: { inSelect: { table: "tags", column: "id", where: liveTagsWithLabel } } },
+        },
+      },
+    });
+  }
+  return { $and: all };
+}
+
+/** Pinned first; ties fall back to id ascending in both directions. */
+function listOrder(query: ListQuery): OrderBy[] {
+  const by: OrderBy =
+    query.sort === "name"
+      ? { column: "name", dir: query.order, nocase: true }
+      : { column: query.sort === "created" ? "created_at" : "updated_at", dir: query.order };
+  return [{ column: "pinned", dir: "desc" }, by, { column: "id" }];
+}
+
+/** One page of the projects the viewer may list, and how many match in all. One query. */
+export async function listPage(db: Db, viewer: Viewer, query: ListQuery): Promise<{ rows: ProjectRow[]; total: number }> {
+  return db.selectPage("projects", {
+    where: listFilter(viewer, query),
+    orderBy: listOrder(query),
+    limit: query.perPage,
+    offset: (query.page - 1) * query.perPage,
+  });
+}
