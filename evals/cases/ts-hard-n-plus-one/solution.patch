+import type { Db } from "../db/types.ts";
+import type { ProjectRow } from "../db/schema.ts";
+import { NOISE_KIND } from "../repos/activity.ts";
+import type { ActivityView } from "../repos/activity.ts";
+import { sortMembers } from "../repos/members.ts";
+import type { MemberView } from "../repos/members.ts";
+import { sortTags, toView } from "../repos/tags.ts";
+import type { TagView } from "../repos/tags.ts";
+import * as users from "../repos/users.ts";
+import { toListItem } from "./project-item.ts";
+import type { ProjectListItem } from "./project-item.ts";
+
+function groupBy<T>(rows: readonly T[], key: (row: T) => number): Map<number, T[]> {
+  const groups = new Map<number, T[]>();
+  for (const row of rows) {
+    const k = key(row);
+    const group = groups.get(k);
+    if (group) group.push(row);
+    else groups.set(k, [row]);
+  }
+  return groups;
+}
+
+/**
+ * List items for many projects at once: a fixed number of queries however many projects
+ * there are. Same rules as the per-project helpers in repos/ (active members only, live
+ * tags only, newest non-view event), applied to everything at once.
+ */
+export async function buildItems(db: Db, projects: readonly ProjectRow[]): Promise<ProjectListItem[]> {
+  if (projects.length === 0) return [];
+  const ids = projects.map((p) => p.id);
+
+  const [memberRows, links, tagRows, latest] = await Promise.all([
+    db.select("project_members", { where: { project_id: { in: ids } } }),
+    db.select("project_tags", { where: { project_id: { in: ids } } }),
+    db.select("tags", {
+      where: { id: { inSelect: { table: "project_tags", column: "tag_id", where: { project_id: { in: ids } } } } },
+    }),
+    db.select("activity", {
+      where: { project_id: { in: ids }, kind: { ne: NOISE_KIND } },
+      orderBy: [
+        { column: "at", dir: "desc" },
+        { column: "id", dir: "desc" },
+      ],
+      distinctOn: "project_id",
+    }),
+  ]);
+
+  const people = await users.getByIds(db, [
+    ...memberRows.map((m) => m.user_id),
+    ...latest.flatMap((a) => (a.actor_id === null ? [] : [a.actor_id])),
+  ]);
+  const tagsById = new Map(tagRows.map((t) => [t.id, t]));
+  const membersOf = groupBy(memberRows, (m) => m.project_id);
+  const linksOf = groupBy(links, (l) => l.project_id);
+  const latestOf = new Map(latest.map((a) => [a.project_id, a]));
+
+  return projects.map((project) => {
+    const members: MemberView[] = [];
+    for (const row of membersOf.get(project.id) ?? []) {
+      const user = people.get(row.user_id);
+      if (users.isActive(user)) members.push({ id: user.id, name: user.name, role: row.role });
+    }
+    const tags: TagView[] = [];
+    for (const link of linksOf.get(project.id) ?? []) {
+      const tag = tagsById.get(link.tag_id);
+      if (tag && !tag.archived) tags.push(toView(tag));
+    }
+    const event = latestOf.get(project.id);
+    let activity: ActivityView | null = null;
+    if (event) {
+      const actor = event.actor_id === null ? "System" : (people.get(event.actor_id)?.name ?? "Unknown");
+      activity = { kind: event.kind, at: event.at, actor };
+    }
+    return toListItem(project, sortMembers(members), sortTags(tags), activity);
+  });
+}
