+
+test("an answer to an earlier query does not replace the newer results", async () => {
+  const pending: Array<(r: SearchResult[]) => void> = [];
+  const box = createSearchBox(() => new Promise<SearchResult[]>((resolve) => pending.push(resolve)));
+  box.setQuery("mu");
+  box.setQuery("mug");
+  pending[1](items("Red mug"));
+  await settle();
+  pending[0](items("Muffin tin"));
+  await settle();
+  assert.deepEqual(box.getState().results, items("Red mug"));
+});
